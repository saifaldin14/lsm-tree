{
  "command": [
    "perf",
    "record",
    "-e",
    "cpu-clock:u",
    "-F",
    "99",
    "--call-graph",
    "dwarf,8192",
    "--timestamp",
    "--clockid",
    "mono",
    "-o",
    "/tmp/sa29ali/profile-checked/native/oncpu.data",
    "--",
    "numactl",
    "--physcpubind=0,1,2,3,4,5,6,7",
    "--membind=0",
    "/tmp/sa29ali/build-v2/lsm_system_bench",
    "--phase",
    "run",
    "--mode",
    "native_cpu",
    "--dir",
    "/dev/shm/sa29ali/phase-c-checked/profile-native",
    "--records",
    "50000000",
    "--read-percent",
    "0",
    "--warmup-seconds",
    "30",
    "--duration-seconds",
    "60",
    "--verify",
    "true",
    "--stats-all",
    "true",
    "--threads",
    "16",
    "--subcompactions",
    "8",
    "--pipelined-write",
    "false",
    "--adaptive-yield",
    "false",
    "--background-jobs",
    "8",
    "--batch-size",
    "100",
    "--disable-wal",
    "true",
    "--allow-fallocate",
    "false"
  ],
  "environment": {
    "LSM_DISABLE_GPU_INPUT": "1",
    "LSM_CUDA_SYNC": "blocking",
    "LSM_GPU_OUTPUT_MIN_BLOCK_BYTES": "1024",
    "LSM_MERGE_READ_THREADS": "4",
    "LSM_GPU_MERGE_STREAMS": "2",
    "LSM_GPU_PINNED_PREALLOC_MB": "1024"
  },
  "statistics_scope": "database open through catch-up, before verification",
  "off_cpu": "unavailable: sched:sched_switch tracepoint not accessible"
}
