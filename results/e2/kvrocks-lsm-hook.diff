diff --git a/lsm_lab/kvrocks_transform.cc b/lsm_lab/kvrocks_transform.cc
new file mode 100644
index 0000000..c0359fa
--- /dev/null
+++ b/lsm_lab/kvrocks_transform.cc
@@ -0,0 +1,95 @@
+// lsm-lab hook for Kvrocks: one compaction transform shared by every column family.
+//
+// Environment:
+//   LSM_KVROCKS_TRANSFORM=<name>        install lsm_lab::make_transform(name) (e.g. remote_merge, which
+//                                       reads LSM_REMOTE_ENDPOINT) and the table format it needs
+//   LSM_KVROCKS_TABLE_FORMAT=lsm        only the table format (format_version 6, CRC32C, binary-search
+//                                       data blocks), no transform: the local-compaction baseline
+//   LSM_KVROCKS_NO_COMPACTION_FILTERS=1 do not install Kvrocks' compaction filter factories
+//
+// When the transform or the table format is enabled, one JSON line is written to stderr at exit:
+//   {"event":"lsm_kvrocks_exit","transform":<name|null>,"table_format":<"lsm"|null>,
+//    "compaction_filters":<bool>,"statistics":<BatchTransform::statistics()|null>}
+#include "lsm_lab/block_transform.hpp"
+
+#include <nlohmann/json.hpp>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <memory>
+#include <string>
+
+namespace engine {
+
+bool LsmLabKeepCompactionFilters() { return std::getenv("LSM_KVROCKS_NO_COMPACTION_FILTERS") == nullptr; }
+
+namespace {
+
+struct LsmLabState {
+  std::string transform_name;
+  std::shared_ptr<lsm_lab::BatchTransform> transform;
+  bool table_format = false;
+};
+
+// Never destroyed, so the exit handler can still read it.
+const LsmLabState *g_state = nullptr;
+
+void LsmLabPrintExitStatistics() {
+  nlohmann::json line = {{"event", "lsm_kvrocks_exit"},
+                         {"transform", nullptr},
+                         {"table_format", nullptr},
+                         {"compaction_filters", LsmLabKeepCompactionFilters()},
+                         {"statistics", nullptr}};
+  if (g_state->table_format) line["table_format"] = "lsm";
+  if (g_state->transform) {
+    line["transform"] = g_state->transform_name;
+    line["statistics"] = g_state->transform->statistics();
+  }
+  const auto text = line.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace) + "\n";
+  std::fwrite(text.data(), 1, text.size(), stderr);
+  std::fflush(stderr);
+}
+
+const LsmLabState &LsmLabStateInstance() {
+  static const LsmLabState *state = [] {
+    auto *created = new LsmLabState;
+    if (const char *format = std::getenv("LSM_KVROCKS_TABLE_FORMAT"); format != nullptr && *format != '\0') {
+      if (std::strcmp(format, "lsm") != 0) {
+        std::fprintf(stderr, "LSM_KVROCKS_TABLE_FORMAT must be \"lsm\" or unset (got \"%s\")\n", format);
+        std::exit(2);
+      }
+      created->table_format = true;
+    }
+    if (const char *mode = std::getenv("LSM_KVROCKS_TRANSFORM"); mode != nullptr && *mode != '\0') {
+      try {
+        created->transform = lsm_lab::make_transform(mode);
+      } catch (const std::exception &error) {
+        std::fprintf(stderr, "LSM_KVROCKS_TRANSFORM=%s: %s\n", mode, error.what());
+        std::exit(2);
+      }
+      if (!created->transform) {
+        std::fprintf(stderr, "LSM_KVROCKS_TRANSFORM=%s selects no transform\n", mode);
+        std::exit(2);
+      }
+      created->transform_name = mode;
+      created->table_format = true;
+    }
+    g_state = created;
+    if (created->table_format) std::atexit(LsmLabPrintExitStatistics);
+    return created;
+  }();
+  return *state;
+}
+
+}  // namespace
+
+std::shared_ptr<rocksdb::CompactionBlockTransform> LsmLabCompactionTransform() {
+  return LsmLabStateInstance().transform;
+}
+
+// Set by LSM_KVROCKS_TRANSFORM (merged-input offload reads only this format) or LSM_KVROCKS_TABLE_FORMAT=lsm.
+bool LsmLabTableFormat() { return LsmLabStateInstance().table_format; }
+
+}  // namespace engine
